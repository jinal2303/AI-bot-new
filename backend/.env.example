# Port the NestJS API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the Next.js frontend URL) —
# also used for the WebSocket gateway's CORS policy.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string for the TradeSignal table (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai-bot?schema=public"

# Max signals the bot may generate per calendar day (clamped to [5, 10]
# regardless of what's set here, per the desk's overtrading guard)
MAX_DAILY_SIGNALS=10

# Yahoo Finance symbol for the Nifty 50 index
NIFTY_SYMBOL=^NSEI

# Strike step used to round to the nearest ATM strike
STRIKE_STEP=50

# --- Risk protocol (fixed to 1 lot, ATM delta proxy 0.5) --------------------
# Contract units per lot
LOT_SIZE=65
# Proxy delta used to translate index-point moves into option-premium moves
DELTA_PROXY=0.5

# --- Exit sizing: volatility-based (ATR), not fixed points ------------------
# Stop-loss/target distances scale with the market's own recent volatility:
#   indexTargetPoints   = ATR(14) x ATR_TARGET_MULTIPLIER
#   indexStopLossPoints = ATR(14) x ATR_STOPLOSS_MULTIPLIER
# A wider/choppier session naturally gets more room; a quiet one gets pulled
# in tighter. The 2:1 default is the standard volatility-sized reward:risk
# convention. Cash P&L figures are then fully derived from these distances
# (no separate fixed rupee constant to keep in sync).
ATR_TARGET_MULTIPLIER=2
ATR_STOPLOSS_MULTIPLIER=1

# Minimum target payoff (1 lot, INR) a setup must clear to be taken at all —
# a setup that technically qualifies on RSI/SMA/R:R but only pays a small
# amount (thin ATR, or a target capped by a nearby pivot) is downgraded to
# NO_SIGNAL rather than opened.
MIN_TARGET_CASH_INR=1000

# NOTE: the refresh cadence itself (every 60 seconds) is fixed in
# src/signals/signals.service.ts via @Cron(CronExpression.EVERY_MINUTE)
# since Nest's @Cron decorator needs a compile-time expression. Likewise,
# the 5m candle interval and ATR(14)/SMA(9)/RSI(14) periods are fixed in
# src/market-data/market-data.service.ts and src/indicators/indicators.service.ts,
# and the CURRENT_WEEK/NEXT_WEEK expiry weekday split is fixed in
# src/expiry/expiry.service.ts.
