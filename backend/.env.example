# Port the NestJS API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the Next.js frontend URL) —
# also used for the WebSocket gateway's CORS policy.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string for the TradeSignal table (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai-bot?schema=public"

# Max signals the bot may generate per calendar day — strict daily limit,
# hard-capped at 5 regardless of what's set here, per the desk's
# overtrading guard.
MAX_DAILY_SIGNALS=5

# Daily loss circuit breaker — once this many signals resolve STOPLOSS_HIT
# (the original, un-trailed risk stop) on the same IST date, signal
# generation halts entirely for the rest of the day. TRAIL_STOP_HIT and
# TIME_EXIT don't count — neither is ever a full-risk loss.
MAX_DAILY_STOPLOSS_HITS=2

# Yahoo Finance symbol for the Nifty 50 index
NIFTY_SYMBOL=^NSEI

# Strike step used to round to the nearest ATM strike
STRIKE_STEP=50

# --- Risk protocol (fixed to 1 lot, ATM delta proxy 0.5) --------------------
# Contract units per lot
LOT_SIZE=65
# Proxy delta used to translate index-point moves into option-premium moves
DELTA_PROXY=0.5

# --- Exit sizing: volatility-based (ATR), not fixed points ------------------
# Stop-loss/target distances scale with the market's own recent volatility:
#   indexTargetPoints   = ATR(14) x ATR_TARGET_MULTIPLIER
#   indexStopLossPoints = ATR(14) x ATR_STOPLOSS_MULTIPLIER
# A wider/choppier session naturally gets more room; a quiet one gets pulled
# in tighter. The 2:1 default is the standard volatility-sized reward:risk
# convention. Cash P&L figures are then fully derived from these distances
# (no separate fixed rupee constant to keep in sync).
ATR_TARGET_MULTIPLIER=2
ATR_STOPLOSS_MULTIPLIER=1

# Minimum target payoff (1 lot, INR) a setup must clear to be taken at all —
# a setup that technically qualifies on RSI/SMA/R:R but only pays a small
# amount (thin ATR, or a target capped by a nearby pivot) is downgraded to
# NO_SIGNAL rather than opened.
MIN_TARGET_CASH_INR=1000

# --- Dynamic Profit Protection: trailing stop-loss ---------------------------
# Once an ACTIVE position moves favorably, PositionMonitorService ratchets
# stopLossSpot forward in two stages (never loosening it):
#   1. Breakeven shield  — at +TRAIL_BREAKEVEN_ATR_MULT  x ATR(14), stop → entry.
#   2. Dynamic profit lock — at +TRAIL_PROFIT_LOCK_ATR_MULT x ATR(14), stop →
#      entry ± TRAIL_PROFIT_LOCK_FRACTION x ATR(14) of guaranteed profit.
# A stop hit after either stage resolves as TRAIL_STOP_HIT, not STOPLOSS_HIT.
TRAIL_BREAKEVEN_ATR_MULT=1.0
TRAIL_PROFIT_LOCK_ATR_MULT=1.5
TRAIL_PROFIT_LOCK_FRACTION=0.75

# --- Stale-position time exit -------------------------------------------------
# A position still ACTIVE past STALE_EXIT_MINUTES without hitting target:
#   - if in profit, gets its target pulled in once by STALE_TARGET_REDUCTION_PCT
#   - is force-exited at market (TIME_EXIT) if the favorable move slips back
#     below STALE_MIN_FAVORABLE_ATR_MULT x ATR(14)
STALE_EXIT_MINUTES=30
STALE_TARGET_REDUCTION_PCT=0.30
STALE_MIN_FAVORABLE_ATR_MULT=0.5

# --- Mandatory EOD square-off (no overnight rollover) -------------------------
# This many minutes before the 15:30 IST close, any still-ACTIVE position is
# force-closed at market as TIME_EXIT — derived from the exchange close
# (minutesUntilMarketClose), not a second hardcoded clock, so a 15-minute
# default cutoff always means 15:15 IST without needing to be kept in sync
# by hand if the close time is ever revised.
EOD_SQUAREOFF_MINUTES_BEFORE_CLOSE=15

# --- Dynamic Target Revision / peak giveback exit -----------------------------
# A supplementary protective layer independent of the trailing-stop ratchet
# above: if peak favorable movement ever reached the *scaled* progress
# threshold for this trade's target payoff size, of the distance to the
# ORIGINAL target (initialTargetSpot, immune to any later stale-exit
# reduction), but has since given back more than PEAK_GIVEBACK_ATR_MULT x
# ATR(14) from that peak, the position exits immediately (TRAIL_STOP_HIT,
# reason "Target Revised & Profit Locked at X%") to lock in what's left of a
# faded move rather than wait for the (further-away) stop-loss level.
# The threshold itself is tiered by targetCashINR (derived, not persisted —
# see PositionMonitorService.resolveTargetRevisionThresholdPct()) and is
# hardcoded, not env-configurable:
#   ₹1,000–₹1,500 target payoff → 70% of target distance
#   ₹1,501–₹2,999               → 60%
#   ≥ ₹3,000                    → 50%
PEAK_GIVEBACK_ATR_MULT=0.5

# --- Target progress milestone notifications -----------------------------------
# Every 10s tick, PositionMonitorService measures how far the live price has
# moved toward the position's ORIGINAL target (initialTargetSpot) as a
# percentage, and fires a Telegram + WebSocket ('signal-target-milestone')
# notification the first time it crosses each of 30/40/50/60/70/80/90% —
# each band notifies exactly once per position (lastNotifiedMilestonePct on
# the row is the persisted high-water mark). 100% is TARGET_HIT itself,
# already covered by the ordinary exit notification. The milestone list and
# guard logic are fixed in code (checkTargetMilestones()), not
# env-configurable.

# --- Telegram notifications (optional) ---------------------------------------
# Get a bot token from @BotFather and a chat id from @userinfobot (or your
# group's chat id). Leave both blank to disable delivery — every trailing-
# stop adjustment and exit is still logged server-side either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: the refresh cadence itself (every 60 seconds) is fixed in
# src/signals/signals.service.ts via @Cron(CronExpression.EVERY_MINUTE)
# since Nest's @Cron decorator needs a compile-time expression. Likewise,
# the 5m candle interval and ATR(14)/SMA(9)/RSI(14) periods are fixed in
# src/market-data/market-data.service.ts and src/indicators/indicators.service.ts,
# and the CURRENT_WEEK/NEXT_WEEK expiry weekday split is fixed in
# src/expiry/expiry.service.ts.
