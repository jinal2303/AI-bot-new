// Prisma schema for the Nifty 50 options-signal tracker.
// Run `npm run db:migrate` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  CALL
  PUT
}

enum ExpiryType {
  CURRENT_WEEK
  NEXT_WEEK
}

enum TradeStatus {
  ACTIVE
  TARGET_HIT
  /// The position's *original* entry-time stop-loss was hit — trailStage
  /// was still NONE, i.e. the stop had never been moved into profit.
  STOPLOSS_HIT
  /// A trailing stop was hit instead of the original risk stop — trailStage
  /// was BREAKEVEN or PROFIT_LOCK, so this exit is a locked-in win (or a
  /// scratch at breakeven), not a loss. See PositionMonitorService.
  TRAIL_STOP_HIT
  /// Forced market exit after STALE_EXIT_MINUTES: the position was in
  /// profit but stalled (never reached target) and then gave back most of
  /// that favorable move. See PositionMonitorService.applyStaleExitRule().
  TIME_EXIT
}

enum TargetBasis {
  PIVOT
  ATR
}

/// Progression of the dynamic trailing stop-loss for one position — strictly
/// one-directional (never regresses) as favorable price movement deepens.
enum TrailStage {
  /// stopLossSpot is still the original entry-time risk stop.
  NONE
  /// Favorable move reached 1x ATR(14) — stopLossSpot pulled to breakeven
  /// (entrySpotPrice), so the trade can no longer lose money.
  BREAKEVEN
  /// Favorable move reached (a) 1.3x ATR(14) OR 20 Nifty points — stopLossSpot
  /// floored at 0.5x ATR(14) of guaranteed profit (the breakeven-lock-trap
  /// fix, so the stop never just sits flat at breakeven), or (b) 1.5x ATR(14)
  /// — stopLossSpot pulled further, to 0.75x ATR(14) of guaranteed profit.
  /// See PositionMonitorService.applyTrailingStop().
  PROFIT_LOCK
}

/// One generated trading signal — a persisted, monitored position from
/// entry until it resolves (or the market closes for the day still active).
model TradeSignal {
  id             String      @id @default(uuid())
  /// @db.Timestamptz — an absolute instant, immune to the DB session's
  /// timezone setting. This server's Postgres session timezone happens to
  /// be Asia/Kolkata; a plain (tz-naive) "timestamp" column would silently
  /// store IST wall-clock digits that then get *re*-interpreted as UTC on
  /// read, double-shifting every displayed time forward by 5:30.
  timestamp      DateTime    @default(now()) @db.Timestamptz(3)
  /// IST calendar date (YYYY-MM-DD) the signal was generated on — denormalized
  /// off `timestamp` so the daily-throttle and "today" queries never need a
  /// timezone-aware range scan, just an indexed equality match.
  dateString     String
  direction      Direction
  strikePrice    Float
  expiryType     ExpiryType
  entrySpotPrice Float
  stopLossSpot   Float
  targetSpot     Float
  currentStatus  TradeStatus @default(ACTIVE)
  /// When/where the position was resolved by the 10s monitor (null while ACTIVE).
  resolvedAt     DateTime?   @db.Timestamptz(3)
  resolvedSpot   Float?
  /// Realized cash P&L for 1 lot at resolution — |resolvedSpot - entrySpotPrice|
  /// x DELTA_PROXY x LOT_SIZE, positive for TARGET_HIT, negative for
  /// STOPLOSS_HIT. Persisted (not recomputed later) so it reflects the
  /// actual desk config at the time of the trade, immune to those constants
  /// changing afterward. Null while ACTIVE.
  netCashINR     Float?
  /// The most favorable spot price seen since entry (highest for a CALL,
  /// lowest for a PUT) — updated by the 10s position monitor every tick it
  /// improves. Null until the first tick after creation. The frontend
  /// derives "peak points" as |peakSpot - entrySpotPrice|.
  peakSpot       Float?
  /// The ATR(14) reading (index points) this trade's SL/target distances
  /// were sized from at creation — persisted so the exact original levels
  /// can always be reconstructed and displayed, even as ATR keeps moving
  /// on every later tick. Nullable only for rows from before this field existed.
  atr14          Float?
  /// Whether `targetSpot` came from the nearest support/resistance pivot
  /// or a symmetric ATR distance — see SignalsService.resolveTargetPoints().
  /// Nullable only for rows from before this field existed.
  targetBasis    TargetBasis?
  /// How far the dynamic trailing stop-loss has progressed. `stopLossSpot`
  /// itself is always the live, current stop (ratcheted, never loosened) —
  /// this just records *why* it's where it is, for display and so a hit on
  /// it resolves to TRAIL_STOP_HIT instead of STOPLOSS_HIT. See
  /// PositionMonitorService.applyTrailingStop().
  trailStage     TrailStage   @default(NONE)
  /// Whether the one-time stale-position target reduction (30% tighter,
  /// after STALE_EXIT_MINUTES in profit with no target hit) has already
  /// fired for this position — guards against re-shrinking it every tick.
  /// See PositionMonitorService.applyStaleExitRule().
  staleAdjusted  Boolean      @default(false)
  /// The target level exactly as set at creation, before any later
  /// revision (the stale-exit pull-in, or a dynamic profit-lock exit) can
  /// move `targetSpot` itself. Anchors target-progress milestone tracking
  /// and the scaled profit-lock threshold so both stay stable regardless
  /// of what happens to the live target afterward. Nullable only for rows
  /// from before this field existed (which skip both features).
  initialTargetSpot        Float?
  /// Highest target-progress milestone (30/40/.../90) already notified for
  /// this position — guards against re-notifying the same milestone every
  /// 10s tick. 0 = none yet. See PositionMonitorService.checkTargetMilestones().
  lastNotifiedMilestonePct Int    @default(0)

  // --- Indexes -------------------------------------------------------------
  // dateString:               daily-throttle COUNT and GET /signals/today
  // currentStatus:            the 10s position monitor's "WHERE ACTIVE" scan
  // direction / expiryType:   archive filter dropdowns
  // [dateString, currentStatus]: composite for the common "today's active" path
  // timestamp:                archive default sort / date-range filtering
  @@index([dateString])
  @@index([currentStatus])
  @@index([direction])
  @@index([expiryType])
  @@index([dateString, currentStatus])
  @@index([timestamp])
}
